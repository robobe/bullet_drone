{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bullet: Run example",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "render",
        "--extra",
        "sitl",
        "python",
        "-m",
        "${input:example}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "__NV_PRIME_RENDER_OFFLOAD": "1",
          "__GLX_VENDOR_LIBRARY_NAME": "nvidia"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Altitude hold starts automatically. External-render choice opens the packaged Godot viewer; Betaflight needs built SITL. Angle square opens its packaged viewer and starts automatically; Acro square waits for Godot Start; external RC needs the app."
    }
  ],
  "inputs": [
    {
      "id": "example",
      "type": "pickString",
      "description": "Choose the example to run",
      "options": [
        {
          "label": "Altitude hold",
          "value": "examples.altitude_hold.main"
        },
        {
          "label": "Altitude hold (external renderer)",
          "value": "examples.altitude_hold_external_render.main"
        },
        {
          "label": "Altitude hold (Betaflight SITL)",
          "value": "examples.altitde_hold_bt.main"
        },
        {
          "label": "Position square (Angle)",
          "value": "examples.position_square.main"
        },
        {
          "label": "Position square (Acro)",
          "value": "examples.position_square_acro.main"
        },
        {
          "label": "External RC (app-controlled)",
          "value": "examples.external_rc.main"
        }
      ],
      "default": "examples.altitude_hold.main"
    }
  ]
}
