{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bullet: Run example",
      "icon": {
        "id": "play",
        "color": "terminal.ansiGreen"
      },
      "type": "shell",
      "command": "uv run --frozen --extra render --extra sitl --extra mavlink python -m ${input:example}",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "__NV_PRIME_RENDER_OFFLOAD": "1",
          "__GLX_VENDOR_LIBRARY_NAME": "nvidia"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Automatic examples start immediately. External-render choices open packaged Godot; Betaflight examples need built SITL. External RC needs the app."
    }
  ],
  "inputs": [
    {
      "id": "example",
      "type": "pickString",
      "description": "Choose the example to run",
      "options": [
        {
          "label": "Altitude hold",
          "value": "examples.altitude_hold.main"
        },
        {
          "label": "Altitude hold (external renderer)",
          "value": "examples.altitude_hold_external_render.main"
        },
        {
          "label": "Takeoff (external renderer + SHM camera viewer with FPS)",
          "value": "examples.takeoff_image_viewer.main"
        },
        {
          "label": "Wind control (rendered takeoff + live UI)",
          "value": "examples.wind_control.main"
        },
        {
          "label": "Altitude hold (Betaflight SITL)",
          "value": "examples.altitde_hold_bt.main"
        },
        {
          "label": "Position square (Angle)",
          "value": "examples.position_square.main"
        },
        {
          "label": "Position square (PX4 Iris)",
          "value": "examples.position_square.main --profile custom/iris.yaml"
        },
        {
          "label": "Position square (Acro)",
          "value": "examples.position_square_acro.main"
        },
        {
          "label": "Terrain following (Betaflight SITL)",
          "value": "examples.terrain_following_bt.main"
        },
        {
          "label": "Terrain following (MAVLink telemetry, MSP Acro)",
          "value": "examples.terrain_following_mavlink.main"
        },
        {
          "label": "GPS point-to-point (400 m, MAVLink feedback, MSP Acro)",
          "value": "examples.gps_point_to_point_mavlink.main"
        },
        {
          "label": "External RC (app-controlled)",
          "value": "examples.external_rc.main"
        }
      ],
      "default": "examples.altitude_hold.main"
    }
  ]
}
