{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bullet: Position square (PX4 Iris)",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "render",
        "python",
        "-m",
        "examples.position_square.main",
        "--profile",
        "custom/iris.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "__NV_PRIME_RENDER_OFFLOAD": "1",
          "__GLX_VENDOR_LIBRARY_NAME": "nvidia"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Runs the position-square mission using custom/iris.yaml and custom/iris.urdf in the external renderer."
    },
    {
      "label": "Bullet: Run example",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "render",
        "--extra",
        "sitl",
        "python",
        "-m",
        "${input:example}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "__NV_PRIME_RENDER_OFFLOAD": "1",
          "__GLX_VENDOR_LIBRARY_NAME": "nvidia"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Automatic examples start immediately. External-render choices open packaged Godot; Betaflight altitude and Acro square need built SITL. External RC needs the app."
    }
  ],
  "inputs": [
    {
      "id": "example",
      "type": "pickString",
      "description": "Choose the example to run",
      "options": [
        {
          "label": "Altitude hold",
          "value": "examples.altitude_hold.main"
        },
        {
          "label": "Altitude hold (external renderer)",
          "value": "examples.altitude_hold_external_render.main"
        },
        {
          "label": "Altitude hold (Betaflight SITL)",
          "value": "examples.altitde_hold_bt.main"
        },
        {
          "label": "Position square (Angle)",
          "value": "examples.position_square.main"
        },
        {
          "label": "Position square (Acro)",
          "value": "examples.position_square_acro.main"
        },
        {
          "label": "External RC (app-controlled)",
          "value": "examples.external_rc.main"
        }
      ],
      "default": "examples.altitude_hold.main"
    }
  ]
}
