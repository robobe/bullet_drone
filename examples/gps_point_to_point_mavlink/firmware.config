# Betaflight SITL 2026.6.2 command file for standalone GPS point-to-point flight.
# The sim sends sensor/FDM data to Betaflight; the altitude-hold setup encodes
# GPS coordinates in FDM position and independent pressure in field 17. Examples send RC channels back through MSP.
# Keep these commands compatible with the pinned firmware version.
# Select the standard four-motor X quad layout.
mixer QUADX
# Interpret incoming channels in Roll/Aileron, Pitch/Elevator, Throttle, Yaw/Rudder order.
map AETR1234
# Disable Betaflight's default UDP receiver so the app's MSP RC commands are used.
feature -RX_UDP
# Enable RC input over MSP; the examples send their channel values through MSP.
feature RX_MSP
# Requires BULLET_GPS_FDM_V1 firmware and sensors.gps.enabled.
feature GPS
# Use the FDM-fed virtual receiver, without a GPS UART.
set gps_provider = VIRTUAL
# Disable magnetometer input; this SITL setup does not provide magnetometer data.
set mag_hardware = NONE
# Reverse the yaw PID correction sign to match this SITL motor-spin convention.
set yaw_motors_reversed = ON
# Set the yaw proportional PID gain used by the firmware's yaw-rate controller.
set p_yaw = 10
# Disable yaw integral correction; no accumulated yaw-rate error is applied.
set i_yaw = 0
# Disable yaw feedforward; yaw output comes from feedback control only.
set f_yaw = 0
# AUX mode rule fields are: rule index, mode ID, AUX channel index, low PWM, high PWM.
# Rule 0 enables ARM from AUX1 (channel index 0) when its signal is 1500–2100 µs.
aux 0 0 0 1500 2100
# Rule 1 enables ANGLE mode from AUX2 (channel index 1) over the same PWM range.
# The app sends 18 RC channels over MSP; 1000 µs is below and 2000 µs is inside this range.
aux 1 1 1 1500 2100
# Limit the self-leveling Angle mode target to 45 degrees of roll or pitch.
set angle_limit = 45
# Use Betaflight's ACTUAL rate model: center sensitivity and maximum rate are intuitive.
set rates_type = ACTUAL
# Roll center-stick sensitivity: 7 means about 70 degrees/second in ACTUAL rates.
set roll_rc_rate = 7
# Pitch center-stick sensitivity: 7 means about 70 degrees/second in ACTUAL rates.
set pitch_rc_rate = 7
# Yaw center-stick sensitivity: 7 means about 70 degrees/second in ACTUAL rates.
set yaw_rc_rate = 7
# Roll super-rate: adds up to about 600 degrees/second near full stick (about 670 total).
set roll_srate = 67
# Pitch super-rate: adds up to about 600 degrees/second near full stick (about 670 total).
set pitch_srate = 67
# Yaw super-rate: adds up to about 600 degrees/second near full stick (about 670 total).
set yaw_srate = 67
# Zero roll expo keeps the stick-to-rate curve unshaped around center.
set roll_expo = 0
# Zero pitch expo keeps the stick-to-rate curve unshaped around center.
set pitch_expo = 0
# Zero yaw expo keeps the stick-to-rate curve unshaped around center.
set yaw_expo = 0
# Treat throttle below 1050 µs as low throttle for arming and related checks.
set min_check = 1050
# Set the throttle-curve midpoint to 50 percent of stick travel.
set thr_mid = 50
# Apply no throttle expo, keeping the throttle input curve unshaped.
set thr_expo = 0
# Save the settings into the SITL configuration and restart/apply them.

# Enable telemetry, UART2 uses TCP 5762 with MAVLink function 512 at 115200 baud.
feature TELEMETRY
serial 1 512 115200 57600 115200 115200
# Persist all profile settings.
# Position stream in Hz, 0 disables it.
set mavlink_pos_rate = 20
# Attitude stream in Hz.
set mavlink_extra1_rate = 20
# Heartbeat and HUD stream in Hz.
set mavlink_extra2_rate = 1
save
