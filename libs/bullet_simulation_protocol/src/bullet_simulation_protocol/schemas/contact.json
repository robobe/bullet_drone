{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "stream_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "step_index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "target_id": {"const": "red_truck"},
    "drone_position_m": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number", "minimum": -1000000000000.0, "maximum": 1000000000000.0}
    }
  },
  "required": ["schema_version", "event_id", "stream_id", "step_index", "target_id", "drone_position_m"]
}
