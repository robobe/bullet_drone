# Pinned Betaflight 2026.6.2, IMU-only estimation, noisy external pressure.
mixer QUADX
map AETR1234
feature RX_MSP
set yaw_motors_reversed = ON
set p_yaw = 10
set i_yaw = 0
set f_yaw = 0
# AUX1 arm, AUX2 Angle. Application sends all 18 channels via MSP.
aux 0 0 0 1500 2100
aux 1 1 1 1500 2100
set angle_limit = 45
set rates_type = ACTUAL
set yaw_rc_rate = 7
set yaw_srate = 67
set yaw_expo = 0
set min_check = 1050
set thr_mid = 50
set thr_expo = 0
save
