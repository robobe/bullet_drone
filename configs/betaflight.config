# Unmodified Betaflight 2026.6.2, IMU estimation, pressure encoded as FDM position Z.
mixer QUADX
map AETR1234
# Upstream defaults to UDP RX; MSP must be the only active receiver.
feature -RX_UDP
feature RX_MSP
# Keep ground-truth quaternion/velocity out of GPS and magnetometer fusion.
feature -GPS
set mag_hardware = NONE
set yaw_motors_reversed = ON
set p_yaw = 10
set i_yaw = 0
set f_yaw = 0
# AUX1 arm, AUX2 Angle. Application sends all 18 channels via MSP.
aux 0 0 0 1500 2100
aux 1 1 1 1500 2100
set angle_limit = 45
set rates_type = ACTUAL
set roll_rc_rate = 7
set pitch_rc_rate = 7
set yaw_rc_rate = 7
set roll_srate = 67
set pitch_srate = 67
set yaw_srate = 67
set roll_expo = 0
set pitch_expo = 0
set yaw_expo = 0
set min_check = 1050
set thr_mid = 50
set thr_expo = 0
save
